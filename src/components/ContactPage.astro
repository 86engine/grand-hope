---
// src/components/ContactPage.astro
import PageBanner from "./PageBanner.astro";

const { lang, ui } = Astro.props;
---

<PageBanner
  title={ui.pageTitle}
  breadcrumb={[
    { label: ui.home, href: lang === 'en' ? '/' : `/${lang}` },
    { label: ui.pageTitle }
  ]}
  background="https://img.grand-hope.com.cn/system/about-grand-hope-banner.webp"
/>

<section class="rs-contact-area rs-contact-eight section-space-top">
  <div class="container">
    <div class="row g-5 justify-content-center section-title-space align-items-center">
      <div class="col-xl-7 col-lg-7 col-md-8">
        <div class="rs-section-title-wrapper text-center">
          <span class="rs-section-subtitle has-theme-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="15" viewBox="0 0 11 15" fill="none">
              <path d="M3.14286 10L0 15L8.78104e-07 0L3.14286 5V10Z" fill="#EA5501"></path>
              <path fill-rule="evenodd" clip-rule="evenodd" d="M6.28571 10L3.14286 15L3.14286 10L4.71428 7.5L3.14286 5L3.14286 0L6.28571 5L6.28571 10ZM6.28571 10L7.85714 7.5L6.28571 5V0L11 7.5L6.28571 15V10Z" fill="#EA5501"></path>
            </svg>
            {ui.globalBranch || 'Global Branch'}
          </span>
          <h2 class="rs-section-title">{ui.globalBranchTitle || 'Get in touch with our team'}</h2>
          <p>{ui.globalBranchDesc || 'We have the team and know-how to help you.'}</p>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-12">
        <div class="rs-contact-wrapper">
          <div class="rs-contact-thumb">
            <img src="https://img.grand-hope.com.cn/system/contact-thumb-05.png" alt="contact">
          </div>
          <div class="rs-contact-ripple-wrapper">
            <!-- Jiang Su -->
            <div class="rs-ripple-item ripple-1 rs-ripple-item-0 ripple">
              <div class="rs-ripple-figure">
                <div class="pre-title">
                  <h5 class="title">Jiang Su</h5>
                </div>
                <div class="ripple-desc">
                  <p class="description">No. 4885, Gucheng Road Kunshan City</p>
                </div>
              </div>
              <div class="pre-circle-ripple"></div>
            </div>
            <div class="mobile_item">
              <i class="remove-icon ri-close-line"></i>
              <div class="pre-title">
                <h5 class="title">Jiang Su</h5>
              </div>
              <div class="ripple-desc">
                <p class="description">No. 4885, Gucheng Road Kunshan City</p>
              </div>
            </div>

            <!-- Shang Hai -->
            <div class="rs-ripple-item ripple-2 rs-ripple-item-1 ripple">
              <div class="rs-ripple-figure">
                <div class="pre-title">
                  <h5 class="title">Shang Hai</h5>
                </div>
                <div class="ripple-desc">
                  <p class="description">Qingpu District Liandong U Valley Enterprise Port, Building 12, Block B, F3</p>
                </div>
              </div>
              <div class="pre-circle-ripple"></div>
            </div>
            <div class="mobile_item">
              <i class="remove-icon ri-close-line"></i>
              <div class="pre-title">
                <h5 class="title">Shang Hai</h5>
              </div>
              <div class="ripple-desc">
                <p class="description">Qingpu District Liandong U Valley Enterprise Port, Building 12, Block B, F3</p>
              </div>
            </div>

            <!-- He Nan -->
            <div class="rs-ripple-item ripple-3 rs-ripple-item-2 ripple">
              <div class="rs-ripple-figure">
                <div class="pre-title">
                  <h5 class="title">He Nan</h5>
                </div>
                <div class="ripple-desc">
                  <p class="description">Northwest corner of the intersection of Sanhuan Road and Qingdao Road, Wuyang County, Luohe City</p>
                </div>
              </div>
              <div class="pre-circle-ripple"></div>
            </div>
            <div class="mobile_item">
              <i class="remove-icon ri-close-line"></i>
              <div class="pre-title">
                <h5 class="title">He Nan</h5>
              </div>
              <div class="ripple-desc">
                <p class="description">Northwest corner of the intersection of Sanhuan Road and Qingdao Road, Wuyang County, Luohe City</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="rs-contact-area section-space rs-contact-nine" style="margin-top: -100px;">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <div class="rs-contact-wrapper" style="grid-template-columns: repeat(3, 1fr);">
          <div class="rs-contact-item">
            <div class="rs-contact-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="22" viewBox="0 0 18 22" fill="none"><path d="M9 18.8995L13.9497 13.9497C16.6834 11.2161 16.6834 6.78392 13.9497 4.05025C11.2161 1.31658 6.78392 1.31658 4.05025 4.05025C1.31658 6.78392 1.31658 11.2161 4.05025 13.9497L9 18.8995ZM9 21.7279L2.63604 15.364C-0.87868 11.8492 -0.87868 6.15076 2.63604 2.63604C6.15076 -0.87868 11.8492 -0.87868 15.364 2.63604C18.8787 6.15076 18.8787 11.8492 15.364 15.364L9 21.7279ZM9 11C10.1046 11 11 10.1046 11 9C11 7.89543 10.1046 7 9 7C7.8954 7 7 7.89543 7 9C7 10.1046 7.8954 11 9 11ZM9 13C6.79086 13 5 11.2091 5 9C5 6.79086 6.79086 5 9 5C11.2091 5 13 6.79086 13 9C13 11.2091 11.2091 13 9 13Z" fill="#737373"></path></svg>
            </div>
            <div class="rs-contact-content">
              <h5 class="rs-contact-title">{ui.locationTitle}</h5>
              <a href="#">{ui.locationDesc}</a>
            </div>
          </div>
          <div class="rs-contact-item">
            <div class="rs-contact-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M22.3338 20.6286C23.0854 19.6211 23.6012 18.4577 23.8431 17.2242C24.085 15.9907 24.0468 14.7186 23.7314 13.5019C23.416 12.2851 22.8314 11.1547 22.0207 10.1941C21.21 9.23346 20.194 8.46713 19.0476 7.95164C18.7979 6.51497 18.224 5.15411 17.3695 3.97247C16.515 2.79083 15.4025 1.8195 14.1163 1.13228C12.8302 0.445066 11.4044 0.0600458 9.94712 0.00647694C8.48989 -0.047092 7.03962 0.232199 5.7065 0.82313C4.37338 1.41406 3.1925 2.30108 2.25358 3.41679C1.31465 4.53251 0.642389 5.84756 0.287871 7.26202C-0.0666478 8.67649 -0.0940951 10.1532 0.207615 11.5798C0.509324 13.0065 1.13225 14.3456 2.02907 15.4954L0.361996 17.1505C0.19558 17.3192 0.0828473 17.5333 0.0380233 17.766C-0.00680069 17.9987 0.0182925 18.2394 0.110137 18.4578C0.200111 18.6768 0.352903 18.8643 0.549258 18.9966C0.745613 19.129 0.976743 19.2002 1.21352 19.2014H8.03772C8.71732 20.6341 9.78879 21.8451 11.1281 22.6941C12.4674 23.5431 14.0198 23.9954 15.6055 23.9987H22.8015C23.0383 23.9975 23.2694 23.9263 23.4658 23.794C23.6621 23.6616 23.8149 23.4741 23.9049 23.2551C23.9967 23.0367 24.0218 22.796 23.977 22.5633C23.9322 22.3307 23.8194 22.1165 23.653 21.9478L22.3338 20.6286ZM7.21018 15.6034C7.21183 16.005 7.2439 16.4059 7.30613 16.8027H4.10391L4.52368 16.3949C4.63609 16.2834 4.72531 16.1508 4.7862 16.0047C4.84709 15.8585 4.87844 15.7017 4.87844 15.5434C4.87844 15.3851 4.84709 15.2283 4.7862 15.0822C4.72531 14.936 4.63609 14.8034 4.52368 14.6919C3.85152 14.0271 3.31865 13.235 2.95622 12.3619C2.59378 11.4887 2.40906 10.5521 2.41285 9.60672C2.41285 7.69823 3.171 5.8679 4.52051 4.51839C5.87002 3.16888 7.70035 2.41073 9.60884 2.41073C11.098 2.40178 12.5526 2.85974 13.768 3.72024C14.9835 4.58073 15.8987 5.8005 16.3851 7.20806C16.1212 7.20806 15.8694 7.20806 15.6055 7.20806C13.3789 7.20806 11.2435 8.09256 9.66911 9.66699C8.09469 11.2414 7.21018 13.3768 7.21018 15.6034ZM19.8511 21.6L19.9111 21.66H15.6055C14.2