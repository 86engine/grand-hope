2338Z" fill="white"></path></svg>
            </div>
            <div class="rs-contact-content">
              <h5 class="rs-contact-title">{ui.callTitle}</h5>
              <a href="tel:{ui.phone}">{ui.phone}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="rs-contact-form-area rs-contact-ten section-space-bottom">
  <div class="container" id="call">
    <div class="row justify-content-center">
      <div class="col-xl-12">
        <div class="rs-contact-form">
          <h3 class="rs-contact-form-title" id="get-in-touch">{ui.formTitle}</h3>
          <p class="descrip">{ui.formDesc}</p>
          <form
            id="contact-form"
            action="https://wp.grand-hope.com.cn/wp-json/api/inquiry"
            data-submit-mode="json"
            data-success-message={ui.submitSuccess}
            data-error-message={ui.submitError}
          >
          <div class="row g-5">
            <div class="col-md-4">
              <div class="rs-contact-input">
                <input id="name" name="name" type="text" required
                data-required-message={ui.nameRequired}
                placeholder={ui.namePlaceholder}>
              </div>
            </div>
            <div class="col-md-4">
              <div class="rs-contact-input">
                <input id="email" name="email" type="email" required
                data-required-message={ui.emailRequired}
                data-invalid-message={ui.emailInvalid}
                placeholder={ui.emailPlaceholder}>
              </div>
            </div>
            <div class="col-md-4">
              <div class="rs-contact-input">
                <input id="phone" name="phone" type="text"
                placeholder={ui.phonePlaceholder}>
              </div>
            </div>
            <div class="col-md-12">
              <div class="rs-contact-input">
                <textarea id="content" name="content" maxlength="300" required
                data-required-message={ui.messageRequired}
                placeholder={ui.messagePlaceholder}></textarea>
              </div>
            </div>
            <div class="col-md-12">
              <div class="rs-contact-btn">
                <button type="submit" id="contact" class="rs-btn has-theme-blue">{ui.sendBtn}</button>
              </div>
            </div>
          </div>
          <div id="form-messages"></div>
        </form>
        </div>
      </div>
    </div>
  </div>
</section>
