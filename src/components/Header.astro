---
import { STATIC_PAGES } from "../config/site";
import { getPageURL } from "../data/site.js";
import { getProducts } from "../data/products.js";
import { getApplications } from "../data/applications.js";
import headerI18n from "../../public/data/header-i18n.json" with { type: 'json' };

const { lang, currentContentId } = Astro.props;

const ui = headerI18n[lang] || headerI18n.en;

const products = await getProducts(lang);
const applications = await getApplications(lang);

const locales = [
  { code: 'en', label: 'English' },
  { code: 'ja', label: '日本語' },
  { code: 'zh', label: '中文' },
];
const currentLangLabel = locales.find(l => l.code === lang)?.label || 'English';

const menuLinks = {
  home: STATIC_PAGES.home[lang],
  products: getPageURL('productList', lang),
  applications: getPageURL('applicationList', lang),
  knowledge: getPageURL('knowledgeList', lang),
  updates: getPageURL('newsList', lang),
  about: getPageURL('about', lang),
  downloads: STATIC_PAGES.downloads[lang],
  contact: STATIC_PAGES.contact[lang],
};
---

<header>
  <div class="rs-header-area rs-header-one has-theme-blue" id="header-sticky">
    <div class="container-fluid g-0">
      <div class="rs-header-inner">
        <div class="rs-header-left">
          <div class="rs-header-logo-wrapper">
            <div class="rs-header-logo">
              <a href={STATIC_PAGES.home[lang]}>
                <img src="https://img.grand-hope.com.cn/system/grandhope-new-materials-logo.png" alt={ui.logoAlt}>
              </a>
            </div>
          </div>
        </div>
        <div class="rs-header-menu">
          <nav id="mobile-menu" class="main-menu">
            <ul class="multipage-menu">
              <li class="menu-item-has-children">
                <a href={menuLinks.products}>{ui.products}</a>
                <ul class="submenu last-children">
                {products.map(p => {
                  const productUrl = getPageURL(p.content_id, lang) || '#';
                  return <li><a href={productUrl}>{p.productName}</a></li>;
                })}
                </ul>
              </li>
              <li class="menu-item-has-children">
                <a href={menuLinks.applications}>{ui.applications}</a>
                <ul class="submenu last-children">
                 {applications.map(a => {
                  const applicationUrl = getPageURL(a.content_id, lang) || '#';
                  return <li><a href={applicationUrl}>{a.applicationName}</a></li>;
                  })}
                </ul>
              </li>
              <li class="has-mega-menu menu-item-has-children">
                <a href="javascript:void(0)">{ui.resources}</a>
                <ul class="submenu last-children">
                  <li><a href={menuLinks.knowledge}>{ui.knowledge}</a></li>
                  <li><a href={menuLinks.updates}>{ui.updates}</a></li>
                  <li><a href={menuLinks.downloads}>{ui.downloads}</a></li>
                </ul>
              </li>
              <li><a href={menuLinks.about}>{ui.about}</a></li>
              <li><a href={menuLinks.contact}>{ui.contact}</a></li>
              <li class="menu-item-has-children" style="margin-left: 5em;">
                <a class="active" href="#">{currentLangLabel}</a>
                <ul class="submenu last-children">
                  {locales.map(locale => (
                    <li>
                      <a href={getPageURL(currentContentId, locale.code)} data-lang-switch={locale.code} class:list={[locale.code === lang ? 'active' : '']}>
                        {locale.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            </ul>
          </nav>
        </div>
        <div class="rs-header-right">
          <div class="rs-header-btn">
            <a class="rs-btn has-theme-blue has-icon has-bg" href={`${menuLinks.contact}#get-in-touch`}>
              {ui.getInTouch}
              <span class="icon-box">
                <svg class="icon-first" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><path d="M31.71,15.29l-10-10L20.29,6.71,28.59,15H0v2H28.59l-8.29,8.29,1.41,1.41,10-10A1,1,0,0,0,31.71,15.29Z"/></svg>
                <svg class="icon-second" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><path d="M31.71,15.29l-10-10L20.29,6.71,28.59,15H0v2H28.59l-8.29,8.29,1.41,1.41,10-10A1,1,0,0,0,31.71,15.29Z"/></svg>
              </span>
            </a>
          </div>
          <div class="rs-header-hamburger has-theme-blue">
            <div class="sidebar-toggle">
              <a class="bar-icon" href="javascript:void(0)" aria-label={lang === 'zh' ? '打开菜单' : lang === 'ja' ? 'メニューを開く' : 'Open menu'}>
                <svg xmlns="http://www.w3.org/2000/svg" width="21" height="20" viewBox="0 0 21 20" fill="none" aria-hidden="true"><path d="M8.55566 11H1.55566C1.29045 11 1.03609 11.1054 0.848557 11.2929C0.661021 11.4804 0.555664 11.7348 0.555664 12V19C0.555664 19.2652 0.661021 19.5196 0.848557 19.7071C1.03609 19.8946 1.29045 20 1.55566 20H8.55566C8.82088 20 9.07523 19.8946 9.26277 19.7071C9.45031 19.5196 9.55566 19.2652 9.55566 19V12C9.55566 11.7348 9.45031 11.4804 9.26277 11.2929C9.07523 11.1054 8.82088 11 8.55566 11ZM7.55566 18H2.55566V13H7.55566V18ZM19.5557 0H12.5557C12.2904 0 12.0361 0.105357 11.8486 0.292893C11.661 0.48043 11.5557 0.734784 11.5557 1V8C11.5557 8.26522 11.661 8.51957 11.8486 8.70711C12.0361 8.89464 12.2904 9 12.5557 9H19.5557C19.8209 9 20.0752 8.89464 20.2628 8.70711C20.4503 8.51957 20.5557 8.26522 20.5557 8V1C20.5557 0.734784 20.4503 0.48043 20.2628 0.292893C20.0752 0.105357 19.8209 0 19.5557 0ZM18.5557 7H13.5557V2H18.5557V7ZM19.5557 11H12.5557C12.2904 11 12.0361 11.1054 11.8486 11.2929C11.661 11.4804 11.5557 11.7348 11.5557 12V19C11.5557 19.2652 11.661 19.5196 11.8486 19.7071C12.0361 19.8946 12.2904 20 12.5557 20H19.5557C19.8209 20 20.0752 19.8946 20.2628 19.7071C20.4503 19.5196 20.5557 19.2652 20.5557 19V12C20.5557 11.7348 20.4503 11.4804 20.2628 11.2929C20.0752 11.1054 19.8209 11 19.5557 11ZM18.5557 18H13.5557V13H18.5557V18ZM8.55566 0H1.55566C1.29045 0 1.03609 0.105357 0.848557 0.292893C0.661021 0.48043 0.555664 0.734784 0.555664 1V8C0.555664 8.26522 0.661021 8.51957 0.848557 8.70711C1.03609 8.89464 1.29045 9 1.55566 9H8.55566C8.82088 9 9.07523 8.89464 9.26277 8.70711C9.45031 8.51957 9.55566 8.26522 9.55566 8V1C9.55566 0.734784 9.45031 0.48043 9.26277 0.292893C9.07523 0.105357 8.82088 0 8.55566 0ZM7.55566 7H2.55566V2H7.55566V7Z" fill="#616161"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<div class="fix">
  <div class="offcanvas-area has-theme-blue" data-lenis-prevent>
    <div class="offcanvas-wrapper">
      <div class="offcanvas-content">
        <div class="offcanvas-top d-flex justify-content-between align-items-center mb-25">
          <div class="offcanvas-logo">
            <a href={STATIC_PAGES.home[lang]}><img src="https://img.grand-hope.com.cn/system/grandhope-new-materials-logo.png" alt={ui.logoAlt}></a>
          </div>
          <div class="offcanvas-close">
            <button class="offcanvas-close-icon animation--flip">
              <span class="offcanvas-m-lines"><span class="offcanvas-m-line line--1"></span><span class="offcanvas-m-line line--2"></span><span class="offcanvas-m-line line--3"></span></span>
            </button>
          </div>
        </div>
        <div class="offcanvas-about mb-30 d-none d-sm-block"><p>{ui.offcanvasAbout}</p></div>
        <div class="offcanvas-gallery d-none d-sm-block">
          <div class="offcanvas-gallery-thumb-wrapper">
            <div class="offcanvas-popup-thumb">
              <img src="https://img.grand-hope.com.cn/system/grand-hope-aerial-view-20260527.webp" loading="lazy" decoding="async" alt={ui.popAlt1}>
            </div>
            <div class="offcanvas-popup-thumb">
              <img src="https://img.grand-hope.com.cn/system/grandhope-factory-corner-20260527.webp" loading="lazy" decoding="async" alt={ui.popAlt2}>
            </div>
            <div class="offcanvas-popup-thumb">
              <img src="https://img.grand-hope.com.cn/system/grandhope-cf17-20260527.webp" loading="lazy" decoding="async" alt={ui.popAlt3}>
            </div>
            <div class="offcanvas-popup-thumb">
              <img src="https://img.grand-hope.com.cn/system/carbon-felt-photovoltaic.webp" loading="lazy" decoding="async" alt={ui.popAlt4}>
            </div>
            <div class="offcanvas-popup-thumb">
              <img src="https://img.grand-hope.com.cn/system/carbon-felt-production-20260527.webp" loading="lazy" decoding="async" alt={ui.popAlt5}>
            </div>
            <div class="offcanvas-popup-thumb">
              <img src="https://img.grand-hope.com.cn/system/carbon-felt-sic-20260527.webp" loading="lazy" decoding="async" alt={ui.popAlt6}>
            </div>
          </div>
        </div>
        <div class="mobile-menu"><div class="rs-offcanvas-menu mb-25"><nav></nav></div></div>
        <div class="offcanvas-contact mb-30">
          <h4 class="offcanvas-title-meta">{ui.contactInfo}</h4>
          <ul>
            <li class="d-flex align-items-center gap-15">
              <div class="offcanvas-contact-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="18" viewBox="0 0 14 18" fill="none">
                  <path d="M11.8768 9.68475C11.3059 10.835 10.5331 11.9818 9.74128 13.0109C8.95198 14.0368 8.15999 14.9249 7.5643 15.5572C7.48514 15.6412 7.40956 15.7206 7.33802 15.7951C7.26648 15.7206 7.1909 15.6412 7.11174 15.5572C6.51605 14.9249 5.72406 14.0368 4.93476 13.0109C4.14299 11.9818 3.37019 10.835 2.79925 9.68475C2.22242 8.52266 1.89032 7.43373 1.89032 6.5C1.89032 3.50846 4.32934 1.08333 7.33802 1.08333C10.3467 1.08333 12.7857 3.50846 12.7857 6.5C12.7857 7.43373 12.4536 8.52266 11.8768 9.68475ZM7.33802 17.3333C7.33802 17.3333 13.8753 11.1732 13.8753 6.5C13.8753 2.91015 10.9484 0 7.33802 0C3.7276 0 0.800781 2.91015 0.800781 6.5C0.800781 11.1732 7.33802 17.3333 7.33802 17.3333Z" fill="#6D6D6D"/>
                  <path d="M7.33802 8.66667C6.13455 8.66667 5.15894 7.69662 5.15894 6.5C5.15894 5.30338 6.13455 4.33333 7.33802 4.33333C8.54149 4.33333 9.5171 5.30338 9.5171 6.5C9.5171 7.69662 8.54149 8.66667 7.33802 8.66667ZM7.33802 9.75C9.14323 9.75 10.6066 8.29492 10.6066 6.5C10.6066 4.70507 9.14323 3.25 7.33802 3.25C5.53281 3.25 4.0694 4.70507 4.0694 6.5C4.0694 8.29492 5.53281 9.75 7.33802 9.75Z" fill="#6D6D6D"/>
                </svg>
              </div>
              <div class="offcanvas-contact-text">
                <a href="#">{ui.address}</a>
              </div>
            </li>
            <li class="d-flex align-items-center gap-15">
              <div class="offcanvas-contact-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M3.65387 1.32849C3.40343 1.00649 2.92745 0.976861 2.639 1.26531L1.60508 2.29923C1.1216 2.78271 0.94387 3.46766 1.1551 4.06847C2.00338 6.48124 3.39215 8.74671 5.32272 10.6773C7.25329 12.6078 9.51876 13.9966 11.9315 14.8449C12.5323 15.0561 13.2173 14.8784 13.7008 14.3949L14.7347 13.361C15.0231 13.0726 14.9935 12.5966 14.6715 12.3461L12.3653 10.5524C12.2008 10.4245 11.9866 10.3793 11.7845 10.4298L9.59541 10.9771C9.00082 11.1257 8.37183 10.9515 7.93845 10.5181L5.48187 8.06155C5.04849 7.62817 4.87427 6.99919 5.02292 6.40459L5.57019 4.21553C5.62073 4.01336 5.57552 3.79918 5.44758 3.63468L3.65387 1.32849ZM1.88477 0.511076C2.62689 -0.231039 3.8515 -0.154797 4.49583 0.673634L6.28954 2.97983C6.6187 3.40304 6.73502 3.95409 6.60498 4.47423L6.05772 6.66329C5.99994 6.8944 6.06766 7.13888 6.2361 7.30732L8.69268 9.7639C8.86113 9.93235 9.1056 10.0001 9.33671 9.94229L11.5258 9.39502C12.0459 9.26499 12.597 9.3813 13.0202 9.71047L15.3264 11.5042C16.1548 12.1485 16.231 13.3731 15.4889 14.1152L14.455 15.1492C13.7153 15.8889 12.6089 16.2137 11.5778 15.8512C9.01754 14.9511 6.61438 13.4774 4.56849 11.4315C2.5226 9.38562 1.04895 6.98246 0.148838 4.42225C-0.213682 3.39112 0.11113 2.28472 0.85085 1.545L1.88477 0.511076Z" fill="#6D6D6D"/>
                  <path d="M11 0.5C11 0.223858 11.2239 0 11.5 0H15.5C15.7761 0 16 0.223858 16 0.5V4.5C16 4.77614 15.7761 5 15.5 5C15.2239 5 15 4.77614 15 4.5V1.70711L10.8536 5.85355C10.6583 6.04882 10.3417 6.04882 10.1464 5.85355C9.95118 5.65829 9.95118 5.34171 10.1464 5.14645L14.2929 1H11.5C11.2239 1 11 0.776142 11 0.5Z" fill="#6D6D6D"/>
                </svg>
              </div>
              <div class="offcanvas-contact-text">
                <a href={`tel:${ui.phone.replace(/\s/g, '')}`}>{ui.phone}</a>
              </div>
            </li>
            <li class="d-flex align-items-center gap-15">
              <div class="offcanvas-contact-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
