---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { LANGS, STATIC_PAGES, isStaticPage } from "../config/site";
import { getTranslationsByContentId } from "../data/site.js";
import "../styles/main.css";

const {
  lang,
  currentContentId,
  title,
  description,
  keywords,
  preloadImages = []
} = Astro.props;

const productionSiteUrl = 'https://grand-hope.com.cn';
const siteUrl = import.meta.env.DEV ? Astro.url.origin : productionSiteUrl;

const alternates = {};
if (currentContentId && isStaticPage(currentContentId)) {
  for (const l of LANGS) {
    alternates[l] = `${siteUrl}${STATIC_PAGES[currentContentId][l]}`;
  }
} else {
  const translations = getTranslationsByContentId(currentContentId);
  if (translations) {
    for (const l of LANGS) {
      if (translations[l]?.link) {
        alternates[l] = translations[l].link;
      }
    }
  }
}

const canonical = alternates[lang] || `${siteUrl}/`;
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title || 'Grand-Hope | Carbon Felt & Graphite Felt Manufacturer'}</title>
    {description && <meta name="description" content={description} />}
    {keywords && <meta name="keywords" content={keywords} />}

    <!-- canonical -->
    <link rel="canonical" href={canonical} />

    <!-- hreflang -->
    {alternates.en && <link rel="alternate" hreflang="en" href={alternates.en} />}
    {alternates.zh && <link rel="alternate" hreflang="zh" href={alternates.zh} />}
    {alternates.ja && <link rel="alternate" hreflang="ja" href={alternates.ja} />}
    {alternates.en && <link rel="alternate" hreflang="x-default" href={alternates.en} />}

    <link rel="dns-prefetch" href="https://img.grand-hope.com.cn" />
    <link rel="preconnect" href="https://img.grand-hope.com.cn" crossorigin />
    {preloadImages.map((href) => (
      <link rel="preload" as="image" href={href} />
    ))}

    <link rel="stylesheet" href="/css/vendor/bootstrap.min.css">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css">
    <link rel="stylesheet" href="/css/plugins/nice-select.css">
    <link rel="stylesheet" href="/css/vendor/magnific-popup.css">
    <link rel="stylesheet" href="/css/vendor/fontawesome-pro.css">
    <link rel="stylesheet" href="/css/vendor/spacing.css">
  </head>
  
  <body>
    <Header lang={lang} currentContentId={currentContentId} />
    <main><slot /></main>
    <Footer lang={lang} />
    <script is:inline defer src="/js/vendor/jquery-3.7.1.min.js"></script>
    <script is:inline defer src="/js/accordion.js"></script>
    <script is:inline defer src="/js/plugins/meanmenu.min.js"></script>
    <script is:inline defer src="/js/plugins/swiper.min.js"></script>
    <script is:inline defer src="/js/vendor/magnific-popup.min.js"></script>
    <script is:inline defer src="/js/plugins/nice-select.min.js"></script>
    <script is:inline defer src="/js/plugins/jarallax.min.js"></script>
    <script is:inline defer src="/js/vendor/ajax-form.js"></script>
    <script is:inline defer src="/js/plugins/parallax-effect.min.js"></script>
    <script is:inline defer src="/js/main.js"></script>
    <script is:inline define:vars={{ alternates, lang }}>
      (() => {
        const preferredLang = localStorage.getItem('cookieLang');
        if (preferredLang && preferredLang !== lang && alternates?.[preferredLang]) {
          const targetUrl = new URL(alternates[preferredLang], window.location.origin);
          const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
          const targetPath = targetUrl.pathname.replace(/\/$/, '') || '/';
          if (targetPath !== currentPath) {
            window.location.replace(targetUrl.href);
            return;
          }
        }

        document.addEventListener('click', (event) => {
          const link = event.target.closest('a[data-lang-switch]');
          if (!link) return;
          const nextLang = link.getAttribute('data-lang-switch');
          if (nextLang) {
            localStorage.setItem('cookieLang', nextLang);
          }
        });
      })();
    </script>
  </body>
</html>
