---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { STATIC_PAGES } from "../../config/site";
import { buildBreadcrumb } from "../../data/site.js";

const lang = 'zh';
const title = 'Cookie 政策 | Grand-Hope';
---

<BaseLayout
  lang={lang}
  currentContentId="privacy-policy"
  title={title}
>
  <section class="rs-breadcrumb-area rs-breadcrumb-one p-relative">
    <div class="rs-breadcrumb-bg" style="background-image: url('https://img.grand-hope.com.cn/system/grand-hope-cookie-banner.webp');"></div>
    <div class="container">
      <div class="row">
        <div class="col-xxl-6 col-xl-8 col-lg-8">
          <div class="rs-breadcrumb-content-wrapper">
            <div class="rs-breadcrumb-title-wrapper">
              <h1 class="rs-breadcrumb-title">Cookie 政策</h1>
            </div>
            <div class="rs-breadcrumb-menu">
              <nav>
                <ul>
                  {buildBreadcrumb(lang, [{ label: 'Cookie 政策' }]).map((item) => (
                    <li><span>{item.href ? <a href={item.href}>{item.label}</a> : item.label}</span></li>
                  ))}
                </ul>
              </nav>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="rs-postbox-area section-space">
    <div class="container">
      <div class="row g-5">
        <div class="col-xl-8 col-lg-8 cookie-content" style="margin:0 auto;float:none;">
          <div class="rs-postbox-details-wrapper content">
            <p class="last-updated">最近更新：2026-04-18</p>
            <section><h2>1. 什么是 Cookie？</h2><p>Cookie 是您在浏览大多数网站时存储在您的设备（电脑、智能手机、平板电脑等）上的小文本文件。除某些情况外，网站必须在获得您的同意后才能在您的设备上存储 Cookie。</p><p>您可以通过更改以下部分或全部 Cookie 设置来管理您的首选项。您也可以允许或禁用所有 Cookie。</p></section>
            <section><h2>2. 我们收集哪些信息？</h2><p>在获得您同意的情况下存储在您设备上的 Cookie，使我们能够收集以下信息：</p><h3>2.1 与您使用的设备相关的信息：</h3><ul><li>您使用的设备类型（智能手机、平板电脑、电脑等）；</li><li>您设备的操作系统（macOS、iOS、Android、Windows、BlackBerry 等）；</li><li>您设备的插件类型和版本；</li><li>使用的浏览器（Safari、Chrome、Internet Explorer 等）；</li><li>您设备的 IP 地址；</li><li>您设备的地理位置数据；</li><li>您的语言偏好。</li></ul><h3>2.2 浏览和用户行为数据：</h3><ul><li>我们网站各个页面的流量统计；</li><li>访问我们网站、在网站内以及离开网站的完整 URL 路径；</li><li>向您展示的任何广告的详细信息；</li><li>您与这些广告的互动情况；</li><li>您在点击广告后采取的操作；</li><li>您接收到投放广告的次数；</li><li>与您的在线活动相关的个人信息。</li></ul></section>
            <section><h2>3. 基础 Cookie</h2><p>这些 Cookie 对网站的正常运行是必要的。其设置无法更改。</p><p>这些基础 Cookie 不需要您的同意。</p></section>
            <section><h2>4. 性能 Cookie</h2><p>这些 Cookie 会统计和分析我们网站的访客数量，以提高网站性能。</p><p>这些 Cookie 需要您事先同意。</p></section>
            <section><h2>5. 广告和社交媒体 Cookie</h2><p>这些 Cookie 用于根据您的偏好，在第三方网站上定制我们的广告。</p><p>这些 Cookie 需要您事先同意。</p></section>
            <section><h2>6. 第三方 Cookie</h2><p>由于我们的网站包含第三方应用程序，我们的合作伙伴可能会设置 Cookie。</p><p>这些 Cookie 需要您事先同意。</p></section>
            <section><h2>7. 这些 Cookie 用于什么，保存多久？</h2>
              <div class="table-responsive">
                <table class="cookie-table">
                  <thead><tr><th>Cookie 类型</th><th>名称</th><th>用途</th><th>Cookie 有效期</th></tr></thead>
                  <tbody><tr><td>基础 Cookie</td><td>Cookie 同意</td><td>检查用户是否接受了 Cookie</td><td>100 天</td></tr><tr><td>性能 Cookie</td><td></td><td>存储 Google Analytics 会话 ID</td><td>2 年</td></tr><tr><td>广告 Cookie</td><td>对 Google 的 Cookie 同意</td><td>检查用户是否同意 Google 的政策</td><td>1 年</td></tr></tbody>
                </table>
              </div>
            </section>
            <section><h2>8. 您的 Cookie 首选项</h2><p>我们在本网站收集和处理您的数据，以更好地了解网站的使用情况。我们将始终征求您的同意。您可以在此处更改隐私设置。</p><p>此外，您还可以通过调整浏览器设置来阻止 Cookie 的设置。请注意，禁用 Cookie 会影响本网站以及您访问的许多其他网站的功能。</p>
              <button id="cookieSettingsBtn" class="rs-btn blue-bg cookie-settings-btn">设置</button>
            </section>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<div class="cookie-overlay" id="cookieModal" style="display:none;">
  <div class="cookie-panel">
    <h2 id="cookieTitle"></h2>
    <p id="cookieDesc"></p>
    <div class="cookie-top-row">
      <a href={STATIC_PAGES['privacy-policy'][lang]} id="cookiePrivacyLink"></a>
      <select id="cookieLang" onchange="window._cookieSetLang(this.value)">
        <option value="en">English</option>
        <option value="ja">日本語</option>
        <option value="zh">中文</option>
      </select>
    </div>
    <div class="cookie-options">
      <label class="cookie-option"><div><strong id="cookieEssentialTitle"></strong><small id="cookieEssentialDesc"></small><em id="cookieEssentialRequired"></em></div><span class="toggle-switch"><input type="checkbox" checked disabled><span class="toggle-slider"></span></span></label>
      <label class="cookie-option"><div><strong id="cookieAnalyzeTitle"></strong><small id="cookieAnalyzeDesc"></small></div><span class="toggle-switch"><input type="checkbox" checked><span class="toggle-slider"></span></span></label>
      <label class="cookie-option"><div><strong id="cookiePersonalizedTitle"></strong><small id="cookiePersonalizedDesc"></small></div><span class="toggle-switch"><input type="checkbox" checked><span class="toggle-slider"></span></span></label>
      <label class="cookie-option"><div><strong id="cookieMarketingTitle"></strong><small id="cookieMarketingDesc"></small></div><span class="toggle-switch"><input type="checkbox" checked><span class="toggle-slider"></span></span></label>
    </div>
    <div class="cookie-actions">
      <button class="cookie-btn primary" id="btnAcceptAll"></button>
      <button class="cookie-btn outline" id="btnStrictlyNecessary"></button>
      <button class="cookie-btn outline" id="btnSaveSettings"></button>
    </div>
  </div>
</div>

<style>
  @import "../../styles/cookie.css";
  .cookie-settings-btn { font-size: 16px; padding: 10px 30px; height: auto; width: auto; }
</style>

<script is:inline>
  (async () => {
    const res = await fetch('/data/cookie-i18n.json');
    const translations = await res.json();

    const ids = {
      cookieTitle: 'title',
      cookieDesc: 'desc',
      cookiePrivacyLink: 'privacy',
      cookieEssentialTitle: 'essentialTitle',
      cookieEssentialDesc: 'essentialDesc',
      cookieEssentialRequired: 'essentialRequired',
      cookieAnalyzeTitle: 'analyzeTitle',
      cookieAnalyzeDesc: 'analyzeDesc',
      cookiePersonalizedTitle: 'personalizedTitle',
      cookiePersonalizedDesc: 'personalizedDesc',
      cookieMarketingTitle: 'marketingTitle',
      cookieMarketingDesc: 'marketingDesc',
      btnAcceptAll: 'acceptAll',
      btnStrictlyNecessary: 'strictlyNecessary',
      btnSaveSettings: 'saveSettings'
    };

    function getPreferredLang() {
      if (translations[document.documentElement.lang]) return document.documentElement.lang;
      const savedLang = localStorage.getItem('cookieLang');
      if (savedLang && translations[savedLang]) return savedLang;
      return 'zh';
    }

    function setLang(nextLang) {
      const t = translations[nextLang];
      if (!t) return;
      const select = document.getElementById('cookieLang');
      select.value = nextLang;
      Object.entries(ids).forEach(([elId, key]) => {
        const el = document.getElementById(elId);
        if (el) el.textContent = t[key] || '';
      });
      const opts = document.querySelectorAll('#cookieLang option');
      if (opts[0]) opts[0].textContent = t.langEn || 'English';
      if (opts[1]) opts[1].textContent = t.langJa || '日本語';
      if (opts[2]) opts[2].textContent = t.langZh || '中文';
      if (window.jQuery && window.jQuery.fn && typeof window.jQuery.fn.niceSelect === 'function') {
        window.jQuery(select).niceSelect('update');
      }
      localStorage.setItem('cookieLang', nextLang);
    }

    window._cookieSetLang = setLang;

    document.getElementById('cookieSettingsBtn')?.addEventListener('click', () => {
      const modal = document.getElementById('cookieModal');
      modal.style.display = 'flex';
      setLang(getPreferredLang());
    });

    document.querySelectorAll('#btnAcceptAll, #btnStrictlyNecessary, #btnSaveSettings').forEach(btn => {
      btn.addEventListener('click', () => {
        document.getElementById('cookieModal').style.display = 'none';

        const newLang = document.getElementById('cookieLang').value;
        const path = window.location.pathname;
        const pageMap = {
          '/privacy-policy': { en: '/privacy-policy', zh: '/zh/privacy-policy', ja: '/ja/privacy-policy' },
          '/zh/privacy-policy': { en: '/privacy-policy', zh: '/zh/privacy-policy', ja: '/ja/privacy-policy' },
          '/ja/privacy-policy': { en: '/privacy-policy', zh: '/zh/privacy-policy', ja: '/ja/privacy-policy' },
          '/privacy-policy/': { en: '/privacy-policy', zh: '/zh/privacy-policy', ja: '/ja/privacy-policy' },
          '/zh/privacy-policy/': { en: '/privacy-policy', zh: '/zh/privacy-policy', ja: '/ja/privacy-policy' },
          '/ja/privacy-policy/': { en: '/privacy-policy', zh: '/zh/privacy-policy', ja: '/ja/privacy-policy' },
        };

        const target = pageMap[path]?.[newLang];
        if (target && target !== path) {
          window.location.href = target;
        }
      });
    });
  })();
</script>
